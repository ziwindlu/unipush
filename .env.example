# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不会入库。
# 启动时会自动加载当前目录下的 .env（已存在的环境变量优先）。

# 调用方使用的 Bearer Token。至少配置一个；不配置时服务会生成随机临时 token 并打印到日志。
UNIPUSH_AUTH_TOKEN=

# ---- Web 控制台 ----

# 首次启动（数据库里还没有用户）时创建的管理员账号。
# 密码留空会自动生成并打印到启动日志；也可以在控制台登录后修改。
UNIPUSH_ADMIN_USER=
UNIPUSH_ADMIN_PASSWORD=
# 忘记密码后离线恢复（随机新密码打印到终端）：bin/unipush -reset-password admin

# Bark 手机推送：在 Bark App 首页复制设备 key。
BARK_DEVICE_KEY=

# 钉钉自定义机器人：webhook 完整地址（含 access_token），以及加签 secret。
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 飞书自定义机器人：webhook 地址；开启加签时再填 secret。
FEISHU_WEBHOOK=
FEISHU_SECRET=

# 企业微信群机器人：webhook 完整地址（含 key=）。
WECOM_WEBHOOK=

# SMTP 邮件：账号、密码与发件人；收件人在 config.yaml 的 channels.email.to 里配置。
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 通用 HTTP webhook 的目标地址。
WEBHOOK_URL=

# ---- CLI / 运维 ----

# push 命令行默认连接的服务地址；不改就用 http://127.0.0.1:8080。
UNIPUSH_URL=

# 日志覆盖：容器里建议 json，排查时可临时调成 debug。
# UNIPUSH_LOG_FORMAT=json
# UNIPUSH_LOG_LEVEL=info
