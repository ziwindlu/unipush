# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不会入库。
# 启动时会自动加载当前目录下的 .env（已存在的环境变量优先）。

# 调用方使用的 Bearer Token。至少配置一个；不配置时服务会生成随机临时 token 并打印到日志。
UNIPUSH_AUTH_TOKEN=

# Bark 手机推送：在 Bark App 首页复制设备 key。
BARK_DEVICE_KEY=

# 钉钉自定义机器人：webhook 完整地址（含 access_token），以及加签 secret。
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 飞书自定义机器人：webhook 地址；开启加签时再填 secret。
FEISHU_WEBHOOK=
FEISHU_SECRET=

# 企业微信群机器人：webhook 完整地址（含 key=）。
WECOM_WEBHOOK=

# SMTP 邮件：账号、密码与发件人；收件人在 config.yaml 的 channels.email.to 里配置。
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 通用 HTTP webhook 的目标地址。
WEBHOOK_URL=
